// Generated by lsc from varint.verify.ts

function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

type Bytes = seq<int>

function pow128(k: int): int
  requires (0 <= k)
  decreases k
  ensures pow128(k) >= 1
{
  if (k == 0) then
    1
  else
    (128 * pow128((k - 1)))
}

lemma pow128_ensures(k: int)
  requires (0 <= k)
  ensures (pow128(k) >= 1)
{
}

function digitsValue(bytes: seq<int>, at: int, k: int): int
  requires (0 <= at)
  requires (0 <= k)
  requires ((at + k) <= |bytes|)
  requires forall j: nat :: ((j < |bytes|) ==> (0 <= bytes[j]))
  decreases k
  ensures digitsValue(bytes, at, k) >= 0
{
  if (k == 0) then
    0
  else
    (digitsValue(bytes, at, (k - 1)) + (JSRem(bytes[((at + k) - 1)], 128) * pow128((k - 1))))
}

lemma digitsValue_ensures(bytes: seq<int>, at: int, k: int)
  requires (0 <= at)
  requires (0 <= k)
  requires ((at + k) <= |bytes|)
  requires forall j: nat :: ((j < |bytes|) ==> (0 <= bytes[j]))
  ensures (digitsValue(bytes, at, k) >= 0)
{
}

function varintSize(n: int): int
  requires (0 <= n)
  requires (n <= MAX_REMAINING_LENGTH)
{
  if (n < 128) then
    1
  else
    if (n < 16384) then
      2
    else
      if (n < 2097152) then
        3
      else
        4
}

lemma varintSize_ensures(n: int)
  requires (0 <= n)
  requires (n <= MAX_REMAINING_LENGTH)
  ensures (1 <= varintSize(n))
  ensures (varintSize(n) <= 4)
  ensures ((varintSize(n) == 1) ==> (n < 128))
  ensures ((varintSize(n) == 2) ==> ((128 <= n) && (n < 16384)))
  ensures ((varintSize(n) == 3) ==> ((16384 <= n) && (n < 2097152)))
  ensures ((varintSize(n) == 4) ==> (2097152 <= n))
{
}

function continues(bytes: seq<int>, offset: int, k: int): bool
  requires (0 <= offset)
  requires (0 <= k)
  requires ((offset + k) < |bytes|)
  decreases k
{
  ((k == 0) || ((bytes[(offset + k)] >= 128) && continues(bytes, offset, (k - 1))))
}

function fieldLength(bytes: seq<int>, offset: int): int
  requires (0 <= offset)
  requires (offset < |bytes|)
{
  if ((offset + 1) >= |bytes|) then
    0
  else
    if (bytes[(offset + 1)] < 128) then
      1
    else
      if ((offset + 2) >= |bytes|) then
        0
      else
        if (bytes[(offset + 2)] < 128) then
          2
        else
          if ((offset + 3) >= |bytes|) then
            0
          else
            if (bytes[(offset + 3)] < 128) then
              3
            else
              if ((offset + 4) >= |bytes|) then
                0
              else
                if (bytes[(offset + 4)] < 128) then
                  4
                else
                  0
}

const MAX_REMAINING_LENGTH: int := 268435455

import opened Std.Arithmetic.Mul

lemma PowersOf128()
  ensures pow128(0) == 1 && pow128(1) == 128 && pow128(2) == 16384 && pow128(3) == 2097152 && pow128(4) == 268435456
{
}

// Appending a byte leaves the value of the first k bytes alone.
lemma DigitsPrefix(a: seq<int>, x: int, k: nat)
  requires k <= |a|
  requires forall j: nat :: j < |a| ==> 0 <= a[j]
  requires 0 <= x
  ensures forall j: nat :: j < |a + [x]| ==> 0 <= (a + [x])[j]
  ensures digitsValue(a + [x], 0, k) == digitsValue(a, 0, k)
  decreases k
{
  assert forall j: nat :: j < |a + [x]| ==> 0 <= (a + [x])[j];
  if k > 0 {
    DigitsPrefix(a, x, k - 1);
  }
}

// k bytes of 7 bits each hold less than 128^k.
lemma DigitsBound(a: seq<int>, k: nat)
  requires k <= |a|
  requires forall j: nat :: j < |a| ==> 0 <= a[j]
  ensures digitsValue(a, 0, k) < pow128(k)
  decreases k
{
  if k > 0 {
    DigitsBound(a, k - 1);
    var p := pow128(k - 1);
    var r := JSRem(a[k - 1], 128);
    assert 0 <= r <= 127;
    assert r * p <= 127 * p by { LemmaMulInequality(r, 127, p); }
    assert pow128(k) == 128 * p;
  }
}

// The digits of an encoding read in place inside a packet, after its first byte, are the digits of the encoding.
lemma DigitsShift(bytes: seq<int>, encoding: seq<int>, k: nat)
  requires k <= |encoding| && 1 + |encoding| <= |bytes|
  requires forall j: nat :: j < |bytes| ==> 0 <= bytes[j]
  requires forall j: nat :: j < |encoding| ==> 0 <= encoding[j]
  requires forall j: nat :: 1 <= j <= |encoding| ==> bytes[j] == encoding[j - 1]
  ensures digitsValue(bytes, 1, k) == digitsValue(encoding, 0, k)
  decreases k
{
  if k > 0 {
    DigitsShift(bytes, encoding, k - 1);
  }
}

// Each of the k bytes that continues covers has the continuation bit.
lemma ContinuesAt(bytes: seq<int>, offset: int, k: int, j: int)
  requires 0 <= offset && 0 <= k && offset + k < |bytes|
  requires continues(bytes, offset, k)
  requires 1 <= j <= k
  ensures bytes[offset + j] >= 128
  decreases k
{
  if j < k {
    ContinuesAt(bytes, offset, k - 1, j);
  }
}

// What fieldLength's answer means: the field's last byte, preceded only by continuation bytes.
lemma FieldLengthFacts(bytes: seq<int>, offset: int)
  requires 0 <= offset < |bytes|
  ensures var f := fieldLength(bytes, offset);
    0 <= f <= 4 && (f > 0 ==> offset + f < |bytes| && bytes[offset + f] < 128 && continues(bytes, offset, f - 1))
{
  var f := fieldLength(bytes, offset);
  if f >= 1 { assert continues(bytes, offset, 0); }
  if f >= 2 { assert continues(bytes, offset, 1); }
  if f >= 3 { assert continues(bytes, offset, 2); }
  if f >= 4 { assert continues(bytes, offset, 3); }
}

method encodeVarint(n: int) returns (res: seq<int>)
  requires (0 <= n)
  requires (n <= MAX_REMAINING_LENGTH)
  ensures (|res| == varintSize(n))
  ensures forall j: nat :: ((j < |res|) ==> ((0 <= res[j]) && (res[j] <= 255)))
  ensures forall j: nat :: (((j + 1) < |res|) ==> (res[j] >= 128))
  ensures (res[(|res| - 1)] < 128)
  ensures (digitsValue(res, 0, |res|) == n)
{
  var out: seq<int> := [];
  var rest := n;
  while true
    invariant (0 <= rest)
    decreases rest
    invariant forall j: nat :: j < |out| ==> 128 <= out[j] <= 255
    invariant |out| == 0 || rest > 0
    invariant |out| <= 3
    invariant n == digitsValue(out, 0, |out|) + rest * pow128(|out|)
  {
    var digit := JSRem(rest, 128);
    rest := JSFloorDiv(rest, 128);
    ghost var before := out;
    ghost var k := |out|;
    assert digit == (rest * 128 + digit) % 128;
    assert n == digitsValue(before, 0, k) + (rest * 128 + digit) * pow128(k);
    PowersOf128();
    out := (out + [(if (rest > 0) then (digit + 128) else digit)]);
    DigitsPrefix(before, out[k], k);
    assert digitsValue(out, 0, k + 1) == digitsValue(before, 0, k) + digit * pow128(k);
    assert (rest * 128 + digit) * pow128(k) == rest * pow128(k + 1) + digit * pow128(k);
    DigitsBound(out, k + 1);
    if (rest == 0) {
      return out;
    }
  }
}

method packetSize(bytes: seq<int>, offset: int) returns (res: int)
  requires (0 <= offset)
  requires (offset < |bytes|)
  requires forall j: nat :: ((j < |bytes|) ==> ((0 <= bytes[j]) && (bytes[j] <= 255)))
  ensures (res >= -1)
  ensures ((res == -1) <==> (((offset + 4) < |bytes|) && continues(bytes, offset, 4)))
  ensures ((res == 0) <==> (((offset + 4) >= |bytes|) && continues(bytes, offset, ((|bytes| - 1) - offset))))
  ensures ((res > 0) ==> (res == ((1 + fieldLength(bytes, offset)) + digitsValue(bytes, (offset + 1), fieldLength(bytes, offset)))))
{
  var n := 0;
  var scale := 1;
  var i := 1;
  while (i <= 4)
    invariant (1 <= i)
    invariant (i <= 5)
    invariant (((offset + i) - 1) < |bytes|)
    invariant continues(bytes, offset, (i - 1))
    invariant (n == digitsValue(bytes, (offset + 1), (i - 1)))
    invariant (scale == pow128((i - 1)))
  {
    var at := (offset + i);
    if (at >= |bytes|) {
      return 0;
    }
    var b := bytes[at];
    n := (n + ((b % 128) * scale));
    assert digitsValue(bytes, offset + 1, i) == digitsValue(bytes, offset + 1, i - 1) + JSRem(b, 128) * pow128(i - 1);
    if (b < 128) {
      if i > 1 { ContinuesAt(bytes, offset, i - 1, 1); }
      if i > 2 { ContinuesAt(bytes, offset, i - 1, 2); }
      if i > 3 { ContinuesAt(bytes, offset, i - 1, 3); }
      assert fieldLength(bytes, offset) == i;
      if offset + 4 < |bytes| && continues(bytes, offset, 4) { ContinuesAt(bytes, offset, 4, i); }
      if offset + 4 >= |bytes| && continues(bytes, offset, |bytes| - 1 - offset) { ContinuesAt(bytes, offset, |bytes| - 1 - offset, i); }
      return ((1 + i) + n);
    }
    scale := (scale * 128);
    i := (i + 1);
  }
  return -1;
}

method remainingLength(bytes: seq<int>, offset: int) returns (res: int)
  requires (0 <= offset)
  requires (offset < |bytes|)
  requires forall j: nat :: ((j < |bytes|) ==> ((0 <= bytes[j]) && (bytes[j] <= 255)))
  requires (fieldLength(bytes, offset) > 0)
  ensures (res == digitsValue(bytes, (offset + 1), fieldLength(bytes, offset)))
{
  var n := 0;
  var scale := 1;
  var i := 1;
  FieldLengthFacts(bytes, offset);
  while (i <= 4)
    invariant (1 <= i)
    invariant (i <= fieldLength(bytes, offset))
    invariant continues(bytes, offset, (i - 1))
    invariant (n == digitsValue(bytes, (offset + 1), (i - 1)))
    invariant (scale == pow128((i - 1)))
  {
    var b := bytes[(offset + i)];
    n := (n + ((b % 128) * scale));
    assert digitsValue(bytes, offset + 1, i) == digitsValue(bytes, offset + 1, i - 1) + JSRem(b, 128) * pow128(i - 1);
    if (b < 128) {
      if i < fieldLength(bytes, offset) { ContinuesAt(bytes, offset, fieldLength(bytes, offset) - 1, i); }
      return n;
    }
    scale := (scale * 128);
    i := (i + 1);
  }
  return n;
}

// Round trip: a fixed header whose remaining length was written by encodeVarint, followed by any bytes at all,
// decodes to exactly 1 + |encoding| + n, and remainingLength reads back n. The encoding's last byte is its only
// byte without the continuation bit, so the field the decoder finds is the one the encoder wrote.
method RoundTrip(n: int, first: int, rest: seq<int>)
  requires 0 <= n <= MAX_REMAINING_LENGTH
  requires 0 <= first <= 255
  requires forall j: nat :: j < |rest| ==> 0 <= rest[j] <= 255
{
  var encoding := encodeVarint(n);
  var bytes := [first] + encoding + rest;
  var L := |encoding|;
  assert forall j: nat :: j < |bytes| ==> 0 <= bytes[j] <= 255;
  assert forall j: nat :: 1 <= j <= L ==> bytes[j] == encoding[j - 1];
  DigitsShift(bytes, encoding, L);
  assert bytes[L] < 128;
  if L > 1 { assert bytes[1] >= 128; }
  if L > 2 { assert bytes[2] >= 128; }
  if L > 3 { assert bytes[3] >= 128; }
  assert fieldLength(bytes, 0) == L;
  var size := packetSize(bytes, 0);
  if offset4Continues(bytes) { ContinuesAt(bytes, 0, 4, L); }
  if 4 >= |bytes| && continues(bytes, 0, |bytes| - 1) { ContinuesAt(bytes, 0, |bytes| - 1, L); }
  assert size == 1 + L + n;
  var remaining := remainingLength(bytes, 0);
  assert remaining == n;
}

predicate offset4Continues(bytes: seq<int>)
{
  4 < |bytes| && continues(bytes, 0, 4)
}
