---
title: "Your QoS 2 publish across dropped connections"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: working
    lg1: bad
    lg2: Breaks YourMessageAtMostOnce
    lg3: Path to the YourMessageAtMostOnce bug
  }
  class lg0 blue
  class lg1 orange
  class lg2 breaks
  class lg3 bugPath
  state "At the same time" as all {
    state "Your publish" as r0 {
      s0: Not published
      s1: Sent, waiting for PUBREC
      [*] --> s0
      s0 --> s1: you publish at QoS 2
    }
    --
    state "Connection" as r1 {
      s2: Connected
      s3: Dropped
      [*] --> s2
      s2 --> s3: the connection drops [when Your publish is Sent, waiting for PUBREC and Broker is Delivered once]
      s3 --> s2: the client reconnects [the broker forgot the session]
    }
    --
    state "Broker" as r2 {
      s4: Not delivered
      s5: Delivered once
      s6: Delivered twice
      [*] --> s4
      s4 --> s5: the broker gets PUBLISH [when Your publish is Sent, waiting for PUBREC]
      s5 --> s6: the broker gets PUBLISH [when Connection is Connected]
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 blue
  class s0 bugPath
  class s1 bugPath
  class s2 bugPath
  class s3 blue
  class s3 bugPath
  class s4 blue
  class s4 bugPath
  class s5 blue
  class s5 bugPath
  class s6 orange
  class s6 breaks
  class s6 bugPath
