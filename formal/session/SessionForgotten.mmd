---
title: "Your QoS 2 publish across dropped connections"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: good
    lg1: working
  }
  class lg0 teal
  class lg1 blue
  state "At the same time" as all {
    state "Your publish" as r0 {
      s0: Not published
      s1: Sent, waiting for PUBREC
      s2: Waiting for a connection
      s3: Given up before sending
      s4: PUBREL sent, waiting for PUBCOMP
      s5: Failed: delivery unknown
      s6: Publish succeeded
      [*] --> s0
      s0 --> s1: you publish at QoS 2 [when Connection is Connected]
      s0 --> s2: you publish at QoS 2 [when Connection is Dropped]
      s2 --> s3: you interrupt the publish
      s2 --> s1: the client reconnects
      s1 --> s4: PUBREC arrives [when Connection is Connected and Broker is Delivered once]
      s1 --> s5: the client reconnects [the broker forgot the session]
      s4 --> s6: PUBCOMP arrives [when Connection is Connected]
      s4 --> s5: the client reconnects [the broker forgot the session]
    }
    --
    state "Connection" as r1 {
      s7: Connected
      s8: Dropped
      [*] --> s7
      s7 --> s8: the connection drops
      s8 --> s7: the client reconnects or the client reconnects [the broker forgot the session]
    }
    --
    state "Broker" as r2 {
      s9: Not delivered
      s10: Delivered once
      [*] --> s9
      s9 --> s10: the broker gets PUBLISH [when Your publish is Sent, waiting for PUBREC and Connection is Connected]
    }
  }
  class s0 blue
  class s1 blue
  class s2 blue
  class s3 blue
  class s4 blue
  class s5 blue
  class s6 teal
  class s9 blue
